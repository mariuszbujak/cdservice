services:
  proxy: 
    image: {{ project_name }}-proxy:{{ nginx_version }}
    ports:
      - "443:443"
      - "80:80"
    hostname: "proxy"
    container_name: "proxy"
    depends_on:
      - "keycloak"

  jenkins:
    image: {{ project_name }}-jenkins:{{ jenkins_version }}
    restart: always
    ports:
      - "8081:8080"
      - "50000:50000"
    environment:
      - JENKINS_OPTS="--prefix=/jenkins
    volumes:
      - jenkins_data:/var/jenkins_home
    hostname: "jenkins"
    container_name: "jenkins"

  jenkins-worker-1:
    image: {{ project_name }}-jenkins-worker:{{ jenkins_worker_version }}
    hostname: "jenkins-worker-1"
    container_name: jenkins-worker-1
    restart: always
    depends_on:
      - jenkins
    environment:
      - JENKINS_URL=http://jenkins:8080/jenkins/
      - JENKINS_AGENT_NAME=jenkins-worker-1
      - JENKINS_SECRET= {{ jenkins_worker_1_secret }}
      - HTTP_PROXY=http://{{ https_domain }}
      - HTTPS_PROXY=http://{{ https_domain }}
      - NO_PROXY=localhost,127.0.0.1,jenkins
      - JENKINS_WEB_SOCKET=true
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock 

  keycloak:
    image: quay.io/keycloak/keycloak:{{ keycloak_version }}
    container_name: "keycloak"
    hostname: "keycloak"
    environment:
      KC_DB_USERNAME: "{{ keycloak_database_user }}"
      KC_DB_PASSWORD: "{{ keycloak_database_password }}"
      KC_DB: postgres
      KC_DB_URL: "jdbc:postgresql://postgres:5432/{{ keycloak_database_name }}"
      KC_CACHE: local
#      KC_BOOTSTRAP_ADMIN_USERNAME: "admin"
#      KC_BOOTSTRAP_ADMIN_PASSWORD: "admin"
    command: "start --proxy-headers xforwarded --http-enabled true --hostname {{ https_domain }}"
#    command: start-dev
    ports:
      - "8080:8080"
    depends_on:
      - "postgres"

  postgres:
    image: {{ project_name }}-postgresql:{{ postgres_version }}
    environment:
      - PGDATA=/var/lib/postgresql/data
      - POSTGRES_DB=postgres
    volumes:
      - postgres_storage:/var/lib/postgresql/data
    ports:
      - "5432:5432"
    restart: always
    hostname: "postgres"
    container_name: "postgres"

networks:
  default:
    name: {{ project_name }}_default
    driver: bridge

volumes:
  jenkins_data:
    driver: local
  postgres_storage:
    driver: local
