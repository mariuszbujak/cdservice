  upstream keycloak_console {
    server keycloak:8080;
  }
  upstream jenkins_backend {
    server jenkins:8080; # Matches the container name and port
    keepalive 32;
  }

  server {
    listen 443 ssl;
    server_name {{ https_domain }};

    ssl_certificate /usr/local/nginx/ssl/client.crt;
    ssl_certificate_key /usr/local/nginx/ssl/client.key;
    include /usr/local/nginx/includes/ssl.conf;

    proxy_buffer_size   128k;
    proxy_buffers       4 256k;
    proxy_busy_buffers_size 256k;
    large_client_header_buffers 4 32k;

    location / {
      proxy_pass http://keycloak_console/;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-Port $server_port;
    }
    location /jenkins/ {
      proxy_pass              http://jenkins_backend/jenkins/;

      proxy_set_header        Host $host;
      proxy_set_header        X-Real-IP $remote_addr;
      proxy_set_header        X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header        X-Forwarded-Proto $scheme;

      # Fix the "It appears that your reverse proxy set up is broken" error
      proxy_redirect          http:// https://;

      # Required for Jenkins websocket agents and CLI
      proxy_http_version      1.1;
      proxy_set_header        Upgrade $http_upgrade;
      proxy_set_header        Connection "upgrade";

      # Increase upload limit for large plugins/artifacts
      client_max_body_size    100m;
      client_body_buffer_size 128k;

      # Timeouts for long-running builds/log streaming
      proxy_connect_timeout   90;
      proxy_send_timeout      90;
      proxy_read_timeout      90;
      proxy_buffering         off;    
    }
    
  }
  server {
    listen 80;
    server_name {{ https_domain }};
    root /usr/local/nginx/html;
    charset UTF-8;
    index index.html;
    error_page 400 401 403 404 500 502 503 504 /page-not-found.html;
    location = /page-not-found.html {
      allow all;
    }
    location / {
      return 301 https://$host$request_uri;    
    }
##    access_log off;
##    log_not_found off;
    error_log /usr/local/nginx/logs/error.log error;
   }
